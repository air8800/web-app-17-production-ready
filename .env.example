# ── Client (Vite) — bundled into the browser; use VITE_ prefix only for public keys ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Server only (Vercel → Settings → Environment Variables) ──
# Do NOT use VITE_ for secrets; /api/* routes cannot read VITE_* in production.

APP_URL=https://www.printget.in

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# PhonePe Payment Gateway (Developer Settings → API Keys — use CLIENT_SECRET, not Salt Key)
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
# PHONEPE_SALT_KEY / PHONEPE_SALT_INDEX are NOT used by this app (legacy API only)
PHONEPE_MERCHANT_ID=
PHONEPE_CLIENT_VERSION=1
# Use "production" for live; omit or any other value for sandbox (api-preprod.phonepe.com)
PHONEPE_ENV=production

# Webhook basic auth (configure same values in PhonePe dashboard webhook settings)
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# Optional: exact paid driving distances (falls back to OSRM if unset)
# Ola is preferred when both keys are configured.
OLA_MAPS_API_KEY=
# Optional backup only; reverse geocoding still uses this if enabled.
GOOGLE_MAPS_API_KEY=
# Optional server safety cap for matrix destinations per request.
DISTANCE_MATRIX_MAX_DESTINATIONS=50

# Email API (order webhooks + partner desktop signup)
WEBHOOK_SECRET=
EMAIL_USER=hello@printget.in
EMAIL_PASS=
PARTNER_OTP_SECRET=
